# Copy to frontend/.env.production before building or running docker compose.
# Vite embeds these at build time.

# Leave empty when nginx proxies /api on the same host (default Docker setup).
VITE_API_URL=

# Google Sign-In on renter checkout — must match backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=

# Optional — map picker on owner listing forms
VITE_GOOGLE_MAPS_API_KEY=

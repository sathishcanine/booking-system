# Backend secrets for Docker Compose (api service)
# Copy: cp .env.docker.example .env
# Or keep your existing backend/.env — compose overrides DATABASE_URL and APP_ENV.

# Stripe (test keys for local Docker)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Admin login (dev values OK when APP_ENV=development)
ADMIN_PASSWORD=changeme
ADMIN_JWT_SECRET=dev-jwt-secret-change-me-in-production
SUPER_ADMIN_EMAIL=admin@localhost

# Google Sign-In — must match VITE_GOOGLE_CLIENT_ID in root .env
GOOGLE_CLIENT_ID=

# Optional SMTP (leave SMTP_HOST empty to disable emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

SITE_TIMEZONE=America/New_York
TAX_RATE_PERCENT=13.0
PLATFORM_FEE_PERCENT=15.0
BOOKING_HOLD_MINUTES=3

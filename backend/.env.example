DATABASE_URL=sqlite:///./bookings.db
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Local dev: http://localhost:5173 — ngrok: set to your https://….ngrok-free.app URL
FRONTEND_URL=http://localhost:5173
TAX_RATE_PERCENT=13.0
# Default platform take rate on owner bookings (super admin can override in dashboard)
PLATFORM_FEE_PERCENT=15.0
BOOKING_HOLD_MINUTES=3
DEFAULT_BOOKING_CUTOFF_HOURS=2
SITE_TIMEZONE=America/New_York
ADMIN_PASSWORD=changeme
# Sign JWTs (min 32 chars in production). Legacy ADMIN_API_KEY is also accepted.
ADMIN_JWT_SECRET=dev-jwt-secret-change-me-in-production
ADMIN_JWT_EXPIRE_MINUTES=30
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900
# Set true in production to refuse weak ADMIN_PASSWORD / ADMIN_JWT_SECRET
REQUIRE_STRONG_ADMIN_SECRETS=false
SUPER_ADMIN_EMAIL=admin@localhost
# Optional — defaults to ADMIN_PASSWORD when unset
SUPER_ADMIN_PASSWORD=
# Google Sign-In (renter checkout). Use the same client ID in frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Copy to backend/.env and replace every placeholder before deploying.
# Docker Compose also sets DATABASE_URL, APP_ENV, and SEED_DEMO_DATA — those override values here.

APP_ENV=production
SEED_DEMO_DATA=false

# PostgreSQL (Compose sets this automatically when using docker compose)
DATABASE_URL=postgresql://booking:CHANGE_ME@db:5432/bookings

# Public site URL — must match your domain exactly (CORS is locked to this in production)
FRONTEND_URL=https://your-domain.com

# Stripe live keys — create webhook at https://your-domain.com/api/webhooks/stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

TAX_RATE_PERCENT=13.0
PLATFORM_FEE_PERCENT=15.0
BOOKING_HOLD_MINUTES=3
DEFAULT_BOOKING_CUTOFF_HOURS=2
SITE_TIMEZONE=America/New_York

# Required — app refuses to start in production if these are weak
ADMIN_PASSWORD=generate-a-strong-password
ADMIN_JWT_SECRET=generate-at-least-32-random-characters-here
ADMIN_JWT_EXPIRE_MINUTES=30
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900

SUPER_ADMIN_EMAIL=you@your-domain.com
SUPER_ADMIN_PASSWORD=generate-another-strong-password

# Must match frontend VITE_GOOGLE_CLIENT_ID when using Google Sign-In
GOOGLE_CLIENT_ID=

# Optional SMTP — leave SMTP_HOST empty to skip confirmation emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bookings@your-domain.com
SMTP_USE_TLS=true

# Requests per minute per IP (0 = disabled). Use Redis-backed limiter for multi-instance deploys.
RATE_LIMIT_PER_MINUTE=120

# Root environment for: docker compose up
# Copy: cp .env.docker.example .env

# Required — database password for the Postgres container
POSTGRES_PASSWORD=change-me-strong-password

# Optional database names (defaults shown)
POSTGRES_USER=booking
POSTGRES_DB=bookings

# Local Docker: use development so weak dev admin passwords are allowed.
# UAT/production deploy: set APP_ENV=production
APP_ENV=development

# Seed demo boats/slots when the database is empty (nice for local Docker testing)
SEED_DEMO_DATA=true

# Public URL of the web container (CORS + Stripe redirects)
FRONTEND_URL=http://localhost:8080

# Host port for the web UI (nginx)
WEB_PORT=8080

# Frontend build-time variables (baked into the web image on build)
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=

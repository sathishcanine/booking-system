# Copy to .env in the repo root for docker compose.
# Compose reads this file automatically.

POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me-generate-a-strong-password
POSTGRES_DB=bookings

# Passed to the frontend image at build time (see frontend/.env.production.example)
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
